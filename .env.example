# Optional private server. The public demo needs no environment variables.
HOST=127.0.0.1
PORT=4318
APP_ORIGIN=http://localhost:4318
RP_ID=localhost
DATABASE_PATH=data/companion.sqlite
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOOTSTRAP_TOKEN=
# Credential-free connection to the existing collector; no Microsoft credential belongs here.
HANDOFF_FILE=
# HTTPS private mode requires a dedicated service identity and explicit Tailscale users.
SERVICE_ACCOUNT_ID=
ALLOWED_TAILNET_LOGINS=
# A collector configuration file the service identity must NOT be able to read.
PROTECTED_COLLECTOR_FILE=
